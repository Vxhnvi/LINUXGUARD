# Copy to .env and edit. Never commit .env.
LINUXGUARD_HOST=127.0.0.1
LINUXGUARD_PORT=5000
LINUXGUARD_DB=data/linuxguard.db
LINUXGUARD_POLL_SECONDS=5
LINUXGUARD_RETENTION_DAYS=7
# Alert hysteresis margin in percentage points: an alert clears only below (threshold - margin)
LINUXGUARD_HYSTERESIS=5
LINUXGUARD_DISK_PATH=/
LINUXGUARD_SERVICES=ssh,cron,docker,nginx
# Required to change thresholds; also protects /api/processes and /api/services when set.
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
LINUXGUARD_API_TOKEN=
# Set to 1 to run the API without the background collector (e.g. in tests)
LINUXGUARD_DISABLE_COLLECTOR=0
